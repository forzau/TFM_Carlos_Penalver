# Originales y salidas pesadas: se sincronizan con OneDrive.
/[Ff]uentes/
/datos/bronze/
# Documentación auxiliar local; publicar entregas y mapa de estructura.
/docs/*
!/docs/entregas/
!/docs/ESTRUCTURA.md

# Notas personales e instrucciones locales: conservar mediante OneDrive.
/contexto/
/AGENTS.md
/resultados/*
!/resultados/.gitkeep
!/resultados/README.md
!/resultados/informes/
/resultados/informes/*
!/resultados/informes/procedencia.json
!/resultados/informes/preparacion/
/resultados/informes/preparacion/*
!/resultados/informes/preparacion/resumen_tablas.csv
!/resultados/informes/preparacion/esquemas.json
!/resultados/informes/preparacion/resumen.json
!/resultados/informes/modelado/
/resultados/informes/modelado/*
!/resultados/informes/modelado/comparacion.csv
!/resultados/informes/modelado/RESULTADOS.md
!/resultados/informes/modelado/perfiles_baseline.csv
!/resultados/informes/modelado/perfiles_modelos.csv
!/resultados/informes/modelado/protocolo.json
!/resultados/informes/modelado/resumen.json
!/resultados/informes/modelado/verificacion_baseline.json
!/resultados/informes/modelado/verificacion_comparacion.json
!/resultados/informes/modelado/imagenes/
/resultados/informes/modelado/imagenes/*
!/resultados/informes/modelado/imagenes/kmeans_k[2-6].png
!/resultados/informes/modelado/imagenes/gmm_k[2-6].png

# Credenciales y configuración privada del equipo.
.env
.env.*
!.env.example

# Entornos y cachés locales.
.venv/
venv/
__pycache__/
*.py[cod]
.ipynb_checkpoints/

# Archivos temporales del sistema y de Office.
.DS_Store
Thumbs.db
desktop.ini
~$*
*.tmp
