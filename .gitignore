# Originales y salidas pesadas: se sincronizan con OneDrive.
/[Ff]uentes/
/datos/bronze/
# Documentación auxiliar local; publicar entregas y mapa de estructura.
/docs/*
!/docs/entregas/
!/docs/ESTRUCTURA.md

# Notas personales e instrucciones locales: conservar mediante OneDrive.
/contexto/
/AGENTS.md
/resultados/*
!/resultados/.gitkeep

# Credenciales y configuración privada del equipo.
.env
.env.*
!.env.example

# Entornos y cachés locales.
.venv/
venv/
__pycache__/
*.py[cod]
.ipynb_checkpoints/

# Archivos temporales del sistema y de Office.
.DS_Store
Thumbs.db
desktop.ini
~$*
*.tmp
